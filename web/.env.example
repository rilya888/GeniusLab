# Canonical public URL (server: robots, sitemap; client: canonical, JSON-LD)
PUBLIC_SITE_URL=https://geniuslab-web-production.up.railway.app
VITE_PUBLIC_SITE_URL=https://geniuslab-web-production.up.railway.app

# Formspree: set ONE of these
VITE_PUBLIC_FORMSPREE_FORM_ID=your-form-id-from-formspree
# VITE_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# GTM (events: virtual_page_view, form_submit, cta_click)
VITE_PUBLIC_GTM_ID=

# GA4 Measurement ID (direct gtag in HTML; enables Google tag verification)
VITE_PUBLIC_GA4_ID=
